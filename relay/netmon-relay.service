[Unit]
Description=one-armed-cake public relay (fans one dashboard stream out to viewers)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
#Environment=RELAY_UPSTREAM=http://127.0.0.1:18081
#Environment=RELAY_PORT=3091
ExecStart=/usr/local/bin/bun /opt/netmon-relay/relay.ts
DynamicUser=yes
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=256M

[Install]
WantedBy=multi-user.target
