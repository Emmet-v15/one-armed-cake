[Unit]
Description=one-armed-cake CAKE traffic shaper
# Ordering only: if the host loads /etc/nftables.conf (which usually starts with
# `flush ruleset`), that must happen before the shaper creates its own table.
# Not Wants=: pulling nftables.service in on a host that does not use it would
# load a default ruleset the admin never asked for.
After=network-online.target nftables.service
# ...and if nftables.service is restarted or reloaded later, its `flush ruleset`
# deletes our table (and with it NAT, so the LAN loses internet): rebuild it.
# Both are no-ops on hosts without nftables.service.
PartOf=nftables.service
ReloadPropagatedFrom=nftables.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/router-shaper start
ExecStop=/usr/local/sbin/router-shaper stop
ExecReload=/usr/local/sbin/router-shaper restart

[Install]
WantedBy=multi-user.target
