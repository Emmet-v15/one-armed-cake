#!/bin/bash
# One-armed CAKE shaper for a line behind an ISP router. Runs on any Linux box
# with one wired interface (WAN_IF) that is the LAN's default gateway.
# Shaping runs on WAN_IF EGRESS (post-NAT) so the real LAN host is visible in
# both directions - the ingress hook cannot do this, because inbound packets
# are still addressed to the router before NAT is reversed.
set -e
export PATH=/usr/sbin:/sbin:/usr/bin:/bin
CONF=/etc/router-shaper.conf
. $CONF
# What counts as a game (see mark()). Unset means these defaults; empty turns
# the rule off. Ports on either end of the flow, as an nftables list.
#   NOT_GAME_UDP  QUIC/HTTPS 443, ZeroTier 9993, Discord 19294-19344,
#                 Tailscale 41641, WireGuard 51820
#   GAME_TCP      Minecraft Java 25565
NOT_GAME_UDP=${NOT_GAME_UDP-443, 9993, 19294-19344, 41641, 51820}
GAME_TCP=${GAME_TCP-25565}
TC=/usr/sbin/tc
IP=/usr/sbin/ip
NFT=/usr/sbin/nft
# Every nftables rule this box needs lives in this one table, created and
# removed here. It never touches other tables, so it coexists with Docker,
# ufw/firewalld or a host firewall in /etc/nftables.conf. (Those can still
# DROP forwarded packets in their own forward chains: allow forwarding there.)
TABLE=one_armed_cake

AF=""; [ "$ACK" = "yes" ] && AF="ack-filter"

# PROFILE=max removes the rate cap entirely, using cake's bare `unlimited`
# keyword -- NOT `bandwidth unlimited`, which tc rejects as "Illegal bandwidth".
# CAKE still does flow isolation and AQM, so the dashboard graphs and per-device
# accounting keep working; it just stops being the bottleneck.
#
# Measured 2026-09-24 on this line: 5.12 Mbps delivered unlimited, 4.91 capped at
# 5300, 3.78 with cake-autorate driving the rate. The tradeoff is real: with no
# cap the queue moves back to the DSLAM, so under sustained contention
# bufferbloat returns. That is the explicit point of this profile.
rates() {
RTT_DL=$RTT
if [ "$PROFILE" = "max" ]; then
    RATE_DL="unlimited"
    # Upload stays shaped by default even in max, because the two directions are
    # not symmetric here:
    #   - unshaping DOWNLOAD is where the throughput is: 5.06 vs 3.78 Mbps (+34%)
    #   - unshaping UPLOAD can win at most ~0.2 Mbps (sync is 2000 kbps, cap is
    #     1800) while upload saturation is what produced the original +433 ms
    #     bufferbloat this whole box exists to fix.
    # So it is nearly free to keep. Set MAX_UNSHAPE_UPLOAD=yes to lift it too.
    if [ "$MAX_UNSHAPE_UPLOAD" = "yes" ]; then
        RATE_UL="unlimited"
    else
        RATE_UL="bandwidth $UL_RATE"
    fi
else
    # gaming (or the old name "shaped"): cap below line capacity so the queue
    # lives in CAKE, where it is kept short, instead of at the DSLAM.
    RATE_DL="bandwidth $DL_RATE"
    RATE_UL="bandwidth $UL_RATE"
    # A shorter rtt makes CoDel react to a ramping flow sooner. On download it
    # cut the worst-case spike from ~50 ms to ~45 ms at no throughput cost.
    RTT_DL=${GAMING_RTT:-$RTT}
fi
}
rates

# Routing: forwarding on, redirects off, and the nftables table (NAT, DSCP
# marking, per-host byte accounting). Idempotent: `add` leaves an existing
# table, chain or set alone, so the accounting counters survive a restart;
# the rules themselves are flushed and rewritten from the current config.
#
# Redirects matter: without them off, the box tells clients "the ISP router is
# on your subnet, go direct", and their traffic bypasses the shaper.
net_up() {
    echo 1 > /proc/sys/net/ipv4/ip_forward
    for c in all default "$WAN_IF"; do
        echo 0 > "/proc/sys/net/ipv4/conf/$c/send_redirects"
    done
    $NFT -f - <<EOF
add table ip $TABLE
add set ip $TABLE up   { type ipv4_addr; size 512; flags dynamic; counter; }
add set ip $TABLE down { type ipv4_addr; size 512; flags dynamic; counter; }
add chain ip $TABLE postrouting { type nat hook postrouting priority srcnat; policy accept; }
add chain ip $TABLE dscp_mark { type filter hook forward priority mangle; policy accept; }
add chain ip $TABLE account { type filter hook forward priority filter; policy accept; }
add chain ip $TABLE output  { type filter hook output priority mangle; policy accept; }
flush chain ip $TABLE postrouting
flush chain ip $TABLE account
add rule ip $TABLE postrouting oifname "$WAN_IF" ip saddr $LAN_SUBNET ip daddr != $LAN_SUBNET masquerade
add rule ip $TABLE account ip saddr $LAN_SUBNET update @up   { ip saddr }
add rule ip $TABLE account ip daddr $LAN_SUBNET update @down { ip daddr }
EOF
    mark
}

# Remove routing entirely: after this the box no longer forwards for the LAN.
net_down() {
    $NFT delete table ip $TABLE 2>/dev/null || true
    echo 0 > /proc/sys/net/ipv4/ip_forward
}

# Game traffic goes to CAKE's Video tin; everything else stays Best Effort.
# Fair queueing alone protects a sparse game flow only while the bulk flows are
# established: when many uploads start at once, each is also "new", and a game
# packet takes turns with all of them. Measured 2026-09-24, 16 uploads starting
# together, 50 Hz UDP probe: 92 ms spikes and 19 lost packets inside CAKE's
# upload queue; marked into a priority tin, 24 ms max and 0 lost.
#
# "Game" is every UDP flow except known non-game UDP, plus Minecraft Java's TCP.
# Earlier rules picked games by packet size and port list, and both missed real
# games: Valorant's upload is p50 359 B (56% over the old 300 B limit), and
# Overwatch and Marvel Rivals use wide or undocumented port ranges. Valorant,
# CS2, Overwatch, Marvel Rivals, MLBB, Factorio and Minecraft Bedrock all use
# UDP, so they match whatever ports they pick. The exceptions keep bulk UDP out:
# QUIC (web, video), Discord (a stream reached 2.8 Mbps down), VPN tunnels.
#
# Video rather than Voice: CAKE serves a tin first only up to its share of the
# link, 50% for Video and 25% for Voice. Valorant alone uploads ~411 kbps, which
# nearly fills Voice at UL_RATE=1800kbit (450k) but sits well inside Video (900k).
# Past its share a tin loses priority rather than starving others, so a false
# match can only cost its own priority. The mark is set in FORWARD, where the
# real LAN host is visible in both directions.
mark() {
    $NFT flush chain ip $TABLE dscp_mark
    local skip=""
    [ -n "$NOT_GAME_UDP" ] && skip="udp sport != { $NOT_GAME_UDP } udp dport != { $NOT_GAME_UDP }"
    $NFT add rule ip $TABLE dscp_mark meta l4proto udp $skip counter ip dscp set af41 comment '"game udp"'
    if [ -n "$GAME_TCP" ]; then
        $NFT add rule ip $TABLE dscp_mark tcp dport "{ $GAME_TCP }" counter ip dscp set af41 comment '"game tcp up"'
        $NFT add rule ip $TABLE dscp_mark tcp sport "{ $GAME_TCP }" counter ip dscp set af41 comment '"game tcp down"'
    fi
    # The dashboard's own latency probes go in the game tin too, so it reports
    # the latency a game gets, not what bulk sees.
    $NFT flush chain ip $TABLE output
    $NFT add rule ip $TABLE output ip daddr 1.1.1.1 tcp dport 443 counter ip dscp set af41
    $NFT add rule ip $TABLE output udp dport 5201 counter ip dscp set af41
}

stop() {
    $TC qdisc del dev "$WAN_IF" root    2>/dev/null || true
    $TC qdisc del dev "$WAN_IF" ingress 2>/dev/null || true
    $TC qdisc del dev ifb-up   root 2>/dev/null || true
    $TC qdisc del dev ifb-down root 2>/dev/null || true
    $IP link del ifb-up   2>/dev/null || true
    $IP link del ifb-down 2>/dev/null || true
}

start() {
    stop
    net_up
    modprobe sch_cake; modprobe ifb
    $IP link add ifb-up   type ifb; $IP link set ifb-up up
    $IP link add ifb-down type ifb; $IP link set ifb-down up

    # classful root on egress purely to host the filters
    $TC qdisc add dev "$WAN_IF" root handle 1: prio bands 3

    # 1) router's own LAN chatter (src+dst local): never shape
    $TC filter add dev "$WAN_IF" parent 1: protocol ip prio 1 u32 \
        match ip src "$LAN_SUBNET" match ip dst "$LAN_SUBNET" action pass
    # 2) dst is a LAN host => this is DOWNLOAD being delivered
    $TC filter add dev "$WAN_IF" parent 1: protocol ip prio 2 u32 \
        match ip dst "$LAN_SUBNET" action mirred egress redirect dev ifb-down
    # 3) anything else => UPLOAD heading to the ISP router
    $TC filter add dev "$WAN_IF" parent 1: protocol ip prio 3 u32 \
        match u32 0 0 action mirred egress redirect dev ifb-up

    # Host isolation: because upload and download have their own qdiscs we know
    # the direction, so the precise options beat triple-isolate (which is the
    # compromise for when you cannot tell). Upload fairness is by source host,
    # download fairness is by destination host; within each host, flows are fair.
    #
    # `nat` on the UPLOAD side is load-bearing, not decoration. tc egress runs
    # AFTER the NAT postrouting hook, so by the time packets reach ifb-up every
    # source address has been masqueraded to the router. Verified by counting in
    # a postrouting chain at priority 200: 7600 packets from the router, zero
    # from the real host. Without `nat`, dual-srchost sees one host for the whole
    # LAN and does nothing at all; `nat` makes CAKE recover the pre-NAT address
    # from conntrack. Download does NOT need it -- inbound NAT is already
    # reversed in PREROUTING, so dual-dsthost sees real hosts (also verified).
    #
    # ack-filter only applies upstream, where the ACK flood actually is.
    $TC qdisc replace dev ifb-up   root cake $RATE_UL $OVERHEAD diffserv4 dual-srchost nat wash rtt $RTT $AF
    $TC qdisc replace dev ifb-down root cake $RATE_DL $OVERHEAD diffserv4 dual-dsthost ingress rtt $RTT_DL
}

case "$1" in
    start) start ;;
    # stop removes shaping only: the LAN keeps routing, unshaped. `down` also
    # removes NAT and forwarding, so the box stops being a router at all.
    stop)  stop ;;
    down)  stop; net_down ;;
    restart) stop; start ;;
    # Rewrite the game-marking rules from the config, without touching the qdiscs.
    mark) mark; echo "marking: game udp, not ports $NOT_GAME_UDP; game tcp ${GAME_TCP:-none}" ;;
    profile)
        want=$2; [ "$want" = "shaped" ] && want=gaming   # old name
        case "$want" in
            gaming|max) ;;
            *) echo "usage: $0 profile {gaming|max}"; exit 1 ;;
        esac
        sed -i "s/^PROFILE=.*/PROFILE=$want/" "$CONF"
        # cake-autorate must not run in max: it would immediately reimpose a cap.
        # It is not installed by default (it cost ~30% throughput on this line; see
        # the paper, "Pilot observations").
        if [ "$want" = "max" ]; then
            systemctl stop cake-autorate 2>/dev/null || true
        fi
        . "$CONF"; rates
        # Change the rate on the live qdiscs rather than rebuilding them: a
        # rebuild drops every queued packet and resets the counters, which is a
        # visible hitch in a game that is running while you switch. `change`
        # keeps every other cake option as it was.
        if $TC qdisc show dev ifb-down 2>/dev/null | grep -q cake &&
           $TC qdisc show dev ifb-up   2>/dev/null | grep -q cake; then
            $TC qdisc change dev ifb-down root cake $RATE_DL rtt $RTT_DL
            $TC qdisc change dev ifb-up   root cake $RATE_UL
        else
            start
        fi
        echo "profile: $PROFILE"
        ;;
    show)
        echo "profile=$PROFILE dl=$DL_RATE ul=$UL_RATE rtt=$RTT ack=$ACK"
        ;;
    status)
        echo "profile: $PROFILE"
        echo "rates: dl $DL_RATE, ul $UL_RATE, rtt $RTT, ack-filter $ACK"
        echo; echo "== ifb-up (UPLOAD) =="; $TC -s qdisc show dev ifb-up
        echo; echo "== ifb-down (DOWNLOAD) =="; $TC -s qdisc show dev ifb-down ;;
    *) echo "usage: $0 {start|stop|down|restart|status|show|mark|profile <gaming|max>}"; exit 1 ;;
esac
