# /etc/dnsmasq.d/one-armed-cake.conf -- DHCP + DNS for a one-armed router.
# Generated by install.sh --dhcp from router/dnsmasq-router.conf.in.
# Turn OFF the ISP router's DHCP server, or the two will race and some
# clients will keep the ISP router as their gateway, bypassing the shaper.
interface=@IFACE@
interface=lo
bind-interfaces

# --- DNS ---
domain-needed
bogus-priv
no-resolv
server=@GATEWAY@
server=1.1.1.1
cache-size=1000
local-service

# --- DHCP ---
# The pool starts at .20, leaving room below for static addresses.
# 12h, not 1h: every renewal rewrites the lease file on disk.
dhcp-range=@RANGE_START@,@RANGE_END@,12h
# THE KEY: hand every client this box as its default gateway
dhcp-option=option:router,@ROUTER_IP@
dhcp-option=option:dns-server,@ROUTER_IP@
dhcp-authoritative
# The dashboard reads DHCP requests from the journal to fingerprint client OSes.
log-dhcp

# --- reservations (example) ---
# Pin a host if you use FAIRNESS=priority, so PRIORITY_HOST stays valid.
#dhcp-host=00:00:5e:00:53:01,192.168.1.100,desktop,infinite
